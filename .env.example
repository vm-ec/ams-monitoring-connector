# Application
APPLICATION_NAME=AMS Monitoring Connector
APPLICATION_VERSION=1.0.0
ENVIRONMENT=DEV

# Connector
CONNECTOR_HOST=0.0.0.0
CONNECTOR_PORT=8000

# Providers
MONITORING_PROVIDER=NEW_RELIC
INCIDENT_PROVIDER=SERVICENOW

# New Relic
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_USER_KEY=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_REGION=US

# Datadog
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# Splunk
SPLUNK_HOST=
SPLUNK_PORT=
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
SPLUNK_HEC_TOKEN=

# Grafana
GRAFANA_URL=
GRAFANA_TOKEN=

# ServiceNow
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Scheduler
SCHEDULER_INTERVAL_MINUTES=5

# Agent
AGENT_URL=

# SendGrid
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# New Relic performance-alert webhook
# Set a long random value. New Relic must send it as the X-Connector-Token header.
NEW_RELIC_WEBHOOK_TOKEN=
PERFORMANCE_SIMULATION_ONLY=true
PERFORMANCE_SIMULATION_ENVIRONMENT=performance-simulation
ALERT_STORE_PATH=data/newrelic_alerts.sqlite3
